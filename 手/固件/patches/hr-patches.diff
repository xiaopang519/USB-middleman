 uint64_t frame_counter = 0;
 
+// --- local additions: host-driven injection ---------------------------------
+// Values arrive over the config feature-report channel (see config.cc).  The
+// command handler runs from tud_task() in the same main-loop context as
+// process_mapping(), so no locking is needed for these.
+#define INJECT_USAGE_MOUSE_X 0x00010030
+#define INJECT_USAGE_MOUSE_Y 0x00010031
+#define INJECT_USAGE_WHEEL 0x00010038
+#define INJECT_USAGE_BTN_1 0x00090001
+#define INJECT_MAX_HELD_KEYS 8
+
+static int32_t inject_dx = 0;
+static int32_t inject_dy = 0;
+static int32_t inject_wheel = 0;
+static bool inject_relative_pending = false;
+static uint8_t inject_buttons = 0;
+static bool inject_buttons_valid = false;
+static uint32_t inject_held_keys[INJECT_MAX_HELD_KEYS] = { 0 };
+static uint8_t inject_held_key_count = 0;
+
+void inject_mouse(int16_t dx, int16_t dy, int16_t wheel, uint8_t buttons, bool buttons_valid) {
+    inject_dx += dx;
+    inject_dy += dy;
+    inject_wheel += wheel;
+    inject_relative_pending = true;
+    if (buttons_valid) {
+        inject_buttons = buttons;
+        inject_buttons_valid = true;
+    }
+}
+
+void inject_key(uint32_t usage, bool down) {
+    uint8_t i;
+    for (i = 0; i < inject_held_key_count; i++) {
+        if (inject_held_keys[i] == usage) {
+            break;
+        }
+    }
+    if (down) {
+        if ((i == inject_held_key_count) && (inject_held_key_count < INJECT_MAX_HELD_KEYS)) {
+            inject_held_keys[inject_held_key_count++] = usage;
+        }
+    } else if (i < inject_held_key_count) {
+        inject_held_keys[i] = inject_held_keys[--inject_held_key_count];
+        inject_held_keys[inject_held_key_count] = 0;
+    }
+}
+
+// Fold the injected relative movement into the same accumulator the normal
+// relative mappings use, so it goes out through the usual report path.
+static void apply_injected_relative(std::unordered_map<uint32_t, int32_t>& acc) {
+    if (!inject_relative_pending) {
+        return;
+    }
+    inject_relative_pending = false;
+    struct {
+        uint32_t usage;
+        int32_t value;
+    } deltas[3] = {
+        { INJECT_USAGE_MOUSE_X, inject_dx },
+        { INJECT_USAGE_MOUSE_Y, inject_dy },
+        { INJECT_USAGE_WHEEL, inject_wheel },
+    };
+    inject_dx = inject_dy = inject_wheel = 0;
+    for (auto const& d : deltas) {
+        if ((d.value != 0) && (our_usages_flat.count(d.usage) != 0)) {
+            acc[d.usage] += d.value * 1000;
+        }
+    }
+}
+
+// Buttons and keys are absolute: re-assert them onto every outgoing report.
+// (defined further down, after put_bits/get_bits)
+static void apply_injected_absolute();
+
 #define HUB_PORT_NONE 255
