@@ -72,7 +72,15 @@ SECTIONS
         /* segments not marked as .flashdata are instead pulled into .data (in RAM) to avoid accidental flash accesses */
         *(SORT_BY_ALIGNMENT(SORT_BY_NAME(.flashdata*)))
         . = ALIGN(4);
-        CMakeFiles/remapper.dir/src/*.o(.text*)
+        /* hid-remapper's own code runs from flash. RAM on RP2040 is only 256k and
+           the whole image is copy_to_ram, so anything left in RAM here is RAM the
+           heap does not get.
+           NOTE: upstream only lists *.o, which silently matches nothing when the
+           build uses Ninja; CMake then names the objects *.obj and every one of
+           our source files falls through to the RAM .text section instead.  Match
+           both extensions, and allow a path prefix so absolute object paths work. */
+        *remapper.dir/src/*.o(.text*)
+        *remapper.dir/src/*.obj(.text*)
         . = ALIGN(4);
     } > FLASH
 
