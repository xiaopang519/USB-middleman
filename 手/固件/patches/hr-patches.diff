+// Buttons and keys are absolute: re-assert them onto every outgoing report.
+static void apply_injected_absolute() {
+    static const uint32_t button_usages[5] = { 0x00090001, 0x00090002, 0x00090003, 0x00090004, 0x00090005 };
+    if (inject_buttons_valid) {
+        for (uint8_t i = 0; i < 5; i++) {
+            auto search = our_usages_flat.find(button_usages[i]);
+            if (search == our_usages_flat.end()) {
+                continue;
+            }
+            if ((inject_buttons >> i) & 1) {
+                const usage_def_t& def = search->second;
+                int32_t existing = get_bits((uint8_t*) reports[def.report_id], report_sizes[def.report_id], def.bitpos, def.size);
+                put_bits((uint8_t*) reports[def.report_id], report_sizes[def.report_id], def.bitpos, def.size, existing | 1);
+            }
+        }
+    }
+    for (uint8_t i = 0; i < inject_held_key_count; i++) {
+        auto search = our_usages_flat.find(inject_held_keys[i]);
+        if (search == our_usages_flat.end()) {
+            continue;
+        }
+        const usage_def_t& def = search->second;
+        put_bits((uint8_t*) reports[def.report_id], report_sizes[def.report_id], def.bitpos, def.size, 1);
+    }
+}
